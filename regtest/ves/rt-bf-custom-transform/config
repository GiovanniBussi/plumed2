plumed_modules=ves
type=driver
arg="--plumed plumed.dat --noatoms"

# Decimal halfway cases can round either way with fused arithmetic.
# Allow one unit of printed precision in these files only.
plumed_tolerance=(
  "bf.derivs-outside.data:1e-6"
  "bf.derivs.data:1e-6"
  "bf.values.data:1e-6"
  "bf2.derivs.data:1e-6"
  "bf2.values.data:1e-6"
  "bf3.derivs.data:1e-6"
  "bf3.values.data:1e-6"
  "bf4.derivs.data:1e-6"
  "bf4.values.data:1e-6"
  "bf5.derivs.data:1e-6"
  "bf5.values.data:1e-6"
)
