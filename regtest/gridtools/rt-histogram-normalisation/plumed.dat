UNITS NATURAL
x: READ FILE=data VALUES=x
lw: READ FILE=data VALUES=logw
y: CUSTOM ARG=x FUNC=1-x PERIODIC=NO
v: CONSTANT VALUES=0.25,0.5,0.75

h: HISTOGRAM ARG=x LOGWEIGHTS=lw NORMALIZATION=true GRID_MIN=0 GRID_MAX=1 GRID_BIN=4 KERNEL=DISCRETE CLEAR=3
raw: HISTOGRAM ARG=x LOGWEIGHTS=lw NORMALIZATION=false GRID_MIN=0 GRID_MAX=1 GRID_BIN=4 KERNEL=DISCRETE CLEAR=3
n: HISTOGRAM ARG=x NORMALIZATION=ndata GRID_MIN=0 GRID_MAX=1 GRID_BIN=4 KERNEL=DISCRETE CLEAR=3
vector: HISTOGRAM ARG=v NORMALIZATION=ndata GRID_MIN=0 GRID_MAX=1 GRID_BIN=4 KERNEL=DISCRETE CLEAR=3
h2: HISTOGRAM ARG=x,y LOGWEIGHTS=lw NORMALIZATION=true GRID_MIN=0,0 GRID_MAX=1,1 GRID_BIN=4,4 KERNEL=DISCRETE CLEAR=3
f: CONVERT_TO_FES GRID=h TEMP=1
m: MATHEVAL ARG=h FUNC=2*x PERIODIC=NO
strided: HISTOGRAM ARG=x LOGWEIGHTS=lw NORMALIZATION=true GRID_MIN=0 GRID_MAX=1 GRID_BIN=4 KERNEL=DISCRETE STRIDE=2 CLEAR=4
limited: HISTOGRAM ARG=x LOGWEIGHTS=lw NORMALIZATION=true GRID_MIN=0 GRID_MAX=1 GRID_BIN=4 KERNEL=DISCRETE UPDATE_FROM=1 UPDATE_UNTIL=4.5

# A raw KDE, an ambiguous combination, and a second accumulation do not have
# the statistical weight of a single originating histogram block.
k: KDE ARG=x GRID_MIN=0 GRID_MAX=1 GRID_BIN=4 KERNEL=DISCRETE
mixed: CUSTOM ARG=h,n FUNC=x+y PERIODIC=NO
temporal: ACCUMULATE ARG=h
transformed_kde: CUSTOM ARG=k FUNC=2*x PERIODIC=NO

DUMPGRID GRID=h FILE=weighted STRIDE=3 FMT=%.9f
DUMPGRID GRID=raw FILE=raw STRIDE=3 FMT=%.9f
DUMPGRID GRID=n FILE=ndata STRIDE=3 FMT=%.9f
DUMPGRID GRID=vector FILE=vector STRIDE=3 FMT=%.9f
DUMPGRID GRID=h2 FILE=twod STRIDE=3 FMT=%.9f
DUMPGRID GRID=f FILE=fes STRIDE=3 FMT=%.9f
DUMPGRID GRID=m FILE=matheval STRIDE=3 FMT=%.9f
DUMPGRID GRID=strided FILE=strided STRIDE=2 FMT=%.9f
DUMPGRID GRID=limited FILE=limited FMT=%.9f
DUMPGRID GRID=k FILE=kde STRIDE=3 FMT=%.9f
DUMPGRID GRID=mixed FILE=mixed STRIDE=3 FMT=%.9f
DUMPGRID GRID=temporal FILE=temporal STRIDE=3 FMT=%.9f
DUMPGRID GRID=transformed_kde FILE=transformed_kde STRIDE=3 FMT=%.9f
