#include <cstdlib>
#include <fstream>

namespace {
struct TestObject {
  unsigned references;
};

struct UnloadMarker {
  ~UnloadMarker() {
    const char *path=std::getenv("MPIW_TEST_KERNEL_MARKER");
    if(path) {
      std::ofstream output(path);
      output << "unloaded\n";
    }
  }
} unload_marker;
}

struct Functions {
  void *(*create)();
  void (*cmd)(void *,const char *,const void *);
  void (*finalize)(void *);
};
struct SymbolTable {
  int version;
  Functions functions;
  void (*cmd_nothrow)(void *,const char *,const void *,void *);
  void (*cmd_safe)(void *,const char *,void *);
  void (*cmd_safe_nothrow)(void *,const char *,void *,void *);
  unsigned (*create_reference)(void *);
  unsigned (*delete_reference)(void *);
  unsigned (*use_count)(void *);
};
extern "C" void *plumed_old_create() {
  const char *path=std::getenv("MPIW_TEST_CREATE_MARKER");
  if(path) {
    std::ofstream output(path);
    output << "created\n";
  }
  TestObject *object=static_cast<TestObject *>(std::malloc(sizeof(TestObject)));
  object->references=1;
  return object;
}
extern "C" void plumed_old_cmd(void *,const char *,const void *) {}
extern "C" void plumed_old_finalize(void *object) {
  std::free(object);
}
extern "C" unsigned plumed_old_create_reference(void *object) {
  return ++static_cast<TestObject *>(object)->references;
}
extern "C" unsigned plumed_old_delete_reference(void *object) {
  return --static_cast<TestObject *>(object)->references;
}
extern "C" unsigned plumed_old_use_count(void *object) {
  return static_cast<TestObject *>(object)->references;
}
extern "C" SymbolTable plumed_symbol_table= {
  4,{plumed_old_create,plumed_old_cmd,plumed_old_finalize},
  nullptr,nullptr,nullptr,plumed_old_create_reference,
  plumed_old_delete_reference,plumed_old_use_count
};
