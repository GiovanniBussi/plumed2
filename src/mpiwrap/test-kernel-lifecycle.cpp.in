#define __PLUMED_WRAPPER_IMPLEMENTATION 1
#define __PLUMED_WRAPPER_EXTERN 0
#define __PLUMED_WRAPPER_LINK_RUNTIME 1
#define __PLUMED_HAS_DLOPEN 1
#include "../wrapper/Plumed.h"

#include <cstdio>
#include <cstdlib>
#include <fstream>

namespace {
bool exists(const char *path) {
  std::ifstream input(path);
  return input.good();
}

void clearMarker(const char *path) {
  std::remove(path);
}

}

int main(int argc,char **argv) {
  if(argc!=6) {
    return 2;
  }
  const char *kernel_marker=argv[4];
  const char *create_marker=argv[5];
  const int caller_owned_descriptor=1;
  setenv("MPIW_TEST_KERNEL_MARKER",kernel_marker,1);
  setenv("MPIW_TEST_CREATE_MARKER",create_marker,1);
  unsetenv("MPIW_TEST_REQUIRE_PROVIDER");
  unsetenv("PLUMED_LOAD_DLCLOSE");
  clearMarker(kernel_marker);
  clearMarker(create_marker);

  // The existing creation entry point still works without an injected
  // descriptor when the kernel does not require one.
  plumed object=plumed_create_dlopen(argv[1]);
  if(!plumed_valid(object)) {
    plumed_finalize(object);
    return 3;
  }
  plumed_finalize(object);
  if(!exists(kernel_marker)) {
    return 4;
  }

  // A fresh kernel requires a provider before create(); successful creation
  // therefore proves installation happened first. Repeating a compatible
  // installation and creating another object must also remain valid.
  clearMarker(kernel_marker);
  setenv("MPIW_TEST_REQUIRE_PROVIDER","1",1);
  const plumed first=plumed_create_dlopen_with_mpi(argv[1],
                     &caller_owned_descriptor);
  if(!plumed_valid(first)) {
    plumed_finalize(first);
    return 5;
  }
  const plumed second=plumed_create_dlopen_with_mpi(argv[1],
                      &caller_owned_descriptor);
  if(!plumed_valid(second)) {
    plumed_finalize(second);
    plumed_finalize(first);
    return 6;
  }
  plumed_finalize(first);
  if(exists(kernel_marker)) {
    plumed_finalize(second);
    return 7;
  }
  plumed_finalize(second);
  if(!exists(kernel_marker)) {
    return 8;
  }

  // The environment-selected creation entry point uses the same
  // pre-creation provider installation and releases its owned dlopen handle.
  clearMarker(kernel_marker);
  setenv("PLUMED_KERNEL",argv[1],1);
  object=plumed_create_with_mpi(&caller_owned_descriptor);
  if(!plumed_valid(object)) {
    plumed_finalize(object);
    return 9;
  }
  plumed_finalize(object);
  if(!exists(kernel_marker)) {
    return 10;
  }
  unsetenv("PLUMED_KERNEL");

  clearMarker(kernel_marker);
  setenv("PLUMED_KERNEL",argv[1],1);
  {
    PLMD::Plumed cpp_object=PLMD::Plumed::createWithMPI(
                              &caller_owned_descriptor);
    if(!cpp_object.valid() || exists(kernel_marker)) {
      return 15;
    }
  }
  if(!exists(kernel_marker)) {
    return 16;
  }
  unsetenv("PLUMED_KERNEL");

  clearMarker(kernel_marker);
  {
    PLMD::Plumed cpp_object=PLMD::Plumed::dlopenWithMPI(argv[1],
                            &caller_owned_descriptor);
    if(!cpp_object.valid() || exists(kernel_marker)) {
      return 17;
    }
  }
  if(!exists(kernel_marker)) {
    return 18;
  }

  // A version-4 symbol table cannot accept injection. The helper returns an
  // invalid object without constructing it, and finalize releases the handle.
  clearMarker(kernel_marker);
  clearMarker(create_marker);
  object=plumed_create_dlopen_with_mpi(argv[2],&caller_owned_descriptor);
  if(plumed_valid(object) || exists(create_marker) || exists(kernel_marker)) {
    plumed_finalize(object);
    return 11;
  }
  plumed_finalize(object);
  if(!exists(kernel_marker)) {
    return 12;
  }

  // The C++ factories preserve invalid handles and still release their
  // runtime-owned library references when the wrapper object is destroyed.
  clearMarker(kernel_marker);
  clearMarker(create_marker);
  setenv("PLUMED_KERNEL",argv[2],1);
  {
    PLMD::Plumed cpp_object=PLMD::Plumed::createWithMPI(
                              &caller_owned_descriptor);
    if(cpp_object.valid() || exists(create_marker) || exists(kernel_marker)) {
      return 19;
    }
  }
  if(!exists(kernel_marker)) {
    return 20;
  }
  unsetenv("PLUMED_KERNEL");

  clearMarker(kernel_marker);
  clearMarker(create_marker);
  {
    PLMD::Plumed cpp_object=PLMD::Plumed::dlopenWithMPI(argv[2],
                            &caller_owned_descriptor);
    if(cpp_object.valid() || exists(create_marker) || exists(kernel_marker)) {
      return 21;
    }
  }
  if(!exists(kernel_marker)) {
    return 22;
  }

  // A provider rejection is returned as an invalid object and its loaded
  // kernel is also released when that object is finalized.
  clearMarker(kernel_marker);
  clearMarker(create_marker);
  object=plumed_create_dlopen_with_mpi(argv[3],&caller_owned_descriptor);
  if(plumed_valid(object) || exists(create_marker) || exists(kernel_marker)) {
    plumed_finalize(object);
    return 13;
  }
  plumed_finalize(object);
  if(!exists(kernel_marker)) {
    return 14;
  }
  return 0;
}
