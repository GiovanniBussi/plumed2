/* Compile with PLUMED_MPIW_HOST_ADAPTER and wrapper implementation enabled. */
#if defined(PLUMED_MPIW_TEST_THREAD_MPI)
#include <thread_mpi/mpi_bindings.h>
#endif
#include "../wrapper/Plumed.h"

int main(void) {
  const void *(*implementation)(void) = plumed_mpi_implementation;
  plumed (*create_with_mpi)(const void *) = plumed_create_with_mpi;
  plumed (*dlopen_with_mpi)(const char *, const void *) =
    plumed_create_dlopen_with_mpi;
  (void)implementation;
  (void)create_with_mpi;
  (void)dlopen_with_mpi;
  return 0;
}
