#include <dlfcn.h>
#include <cstdlib>
#include <cstddef>
#include <fstream>

struct Functions {
  void *(*create)();
  void (*cmd)(void *,const char *,const void *);
  void (*finalize)(void *);
};
struct NothrowHandler {
  void *ptr;
  void (*handler)(void *,int,const char *,const void *);
};
struct SymbolTable {
  int version;
  Functions functions;
  void (*cmd_nothrow)(void *,const char *,const void *,void *);
  void (*cmd_safe)(void *,const char *,void *);
  void (*cmd_safe_nothrow)(void *,const char *,void *,void *);
  unsigned (*create_reference)(void *);
  unsigned (*delete_reference)(void *);
  unsigned (*use_count)(void *);
  int (*install_mpi_provider)(const void *,NothrowHandler);
};

namespace {
bool provider_installed=false;

struct TestObject {
  unsigned references;
};

struct UnloadMarker {
  ~UnloadMarker() {
    const char *path=std::getenv("MPIW_TEST_KERNEL_MARKER");
    if(path) {
      std::ofstream output(path);
      output << "unloaded\n";
    }
  }
} unload_marker;
}

extern "C" void *plumed_test_create() {
  const char *path=std::getenv("MPIW_TEST_CREATE_MARKER");
  if(path) {
    std::ofstream output(path);
    output << "created\n";
  }
  const char *require_provider=std::getenv("MPIW_TEST_REQUIRE_PROVIDER");
  if(require_provider && !provider_installed) {
    return nullptr;
  }
  TestObject *object=static_cast<TestObject *>(std::malloc(sizeof(TestObject)));
  object->references=1;
  return object;
}
extern "C" void plumed_test_cmd(void *,const char *,const void *) {}
extern "C" void plumed_test_finalize(void *object) {
  std::free(object);
}
extern "C" unsigned plumed_test_create_reference(void *object) {
  return ++static_cast<TestObject *>(object)->references;
}
extern "C" unsigned plumed_test_delete_reference(void *object) {
  return --static_cast<TestObject *>(object)->references;
}
extern "C" unsigned plumed_test_use_count(void *object) {
  return static_cast<TestObject *>(object)->references;
}
extern "C" int plumed_test_install(const void *descriptor,
                                   NothrowHandler nothrow) {
  if(!descriptor) {
    return 1;
  }
#ifdef TEST_REJECT_INSTALL
  if(nothrow.handler) {
    void *nested=nullptr;
    const char *nested_tag="n";
    const void *options[]= {nested_tag,&nested,nullptr};
    nothrow.handler(nothrow.ptr,20300,"injected provider type rejection",options);
    if(nested) {
      nothrow.handler(nested,20200,"nested provider rejection",nullptr);
    }
  }
  return 1;
#endif
  provider_installed=true;
  return 0;
}
extern "C" SymbolTable plumed_symbol_table= {
  5,
  {plumed_test_create,plumed_test_cmd,plumed_test_finalize},
  nullptr,nullptr,nullptr,plumed_test_create_reference,
  plumed_test_delete_reference,plumed_test_use_count,
  plumed_test_install
};
