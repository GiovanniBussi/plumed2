#! /bin/sh

awk '{
  if($1 ~ /^_PLUMED_INSTALL_/) next
  if($1=="PLUMED_LIBRARY_DIR" && $2==":=") {
    # MD patches can symlink the export outside the installation.
    print "get_filename_component(_PLUMED_INSTALL_FILE \"${CMAKE_CURRENT_LIST_FILE}\" REALPATH)"
    print "get_filename_component(_PLUMED_INSTALL_DIRECTORY \"${_PLUMED_INSTALL_FILE}\" DIRECTORY)"
    print "get_filename_component(PLUMED_LIBRARY_DIR \"${_PLUMED_INSTALL_DIRECTORY}/../../..\" ABSOLUTE)"
    next
  }
  gsub(/\$\(PLUMED_LIBRARY_DIR\)/,"${PLUMED_LIBRARY_DIR}")
  if(match($1,"[A-Z0-9_]=")){
    sub("="," ")
    $0="set("$0")"
  }
  print 
}'
