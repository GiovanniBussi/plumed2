#! /bin/sh

awk '{
  if($1 ~ /^_PLUMED_INSTALL_/) next
  if($1=="PLUMED_LIBRARY_DIR" && $2==":=") {
    print "get_filename_component(PLUMED_LIBRARY_DIR \"${CMAKE_CURRENT_LIST_DIR}/../../..\" ABSOLUTE)"
    next
  }
  gsub(/\$\(PLUMED_LIBRARY_DIR\)/,"${PLUMED_LIBRARY_DIR}")
  if(match($1,"[A-Z0-9_]=")){
    sub("="," ")
    $0="set("$0")"
  }
  print 
}'
