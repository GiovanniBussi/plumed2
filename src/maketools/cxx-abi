#!/bin/sh
# Preserve a libstdc++ compiler's default string ABI when users compile plugins
# with a different compiler after installation. libc++ needs no such flag.
# Emit literal tokens inside preprocessor branches. Expanding a macro from a
# system header can put GCC line markers between its name and value.
"$@" -x c++ -E - 2>/dev/null <<'PLUMED_ABI_PROBE' | awk '/^PLUMED_CXX_ABI=[01]$/ {sub(/^PLUMED_CXX_ABI=/, ""); print "-D_GLIBCXX_USE_CXX11_ABI=" $0}'
#include <string>
#ifdef _GLIBCXX_USE_CXX11_ABI
#if _GLIBCXX_USE_CXX11_ABI == 0
PLUMED_CXX_ABI=0
#else
PLUMED_CXX_ABI=1
#endif
#endif
PLUMED_ABI_PROBE
