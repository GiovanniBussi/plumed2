

function plumed_preliminary_test(){
# check if the README contains the word GROMACS and if gromacs has been already configured
  grep -q GROMACS README 1>/dev/null 2>/dev/null
}

function plumed_patch_info(){
cat << EOF
A basic PLUMED interface is already present in GROMACS

This patch provides extra features to be implemented in the official PLUMED integration in the next GROMACS version, including:

- multiple walkers (GREX)
- biased replica exchange, including native lambda exchange and ENERGY-dependent biases
- general Hamiltonian replica exchange (-hrex), with PLUMED exchange patterns and
  consistent cross-Hamiltonian ENERGY evaluations
- alchemical metadynamics: EXTRACV NAME=lambda exposes the integer state index;
  calculation-only MCMC evaluations include the current bias and candidate ENERGY
- provider-owned PLUMED state and explicit context passing, including biased
  single-replica alchemical MCMC with thread-MPI; no process-global bridge
- modular-simulator ENERGY requests and expanded-ensemble checkpoint/restart support
- OpenMP thread count passed to PLUMED
- ENERGY CV and energy biasing (OPES multithermal, well-tempered ensemble):
  the native GROMACS module does not compute or pass the potential energy
- checkpoints: PLUMED is told before the force calculation that GROMACS writes a checkpoint,
  so that it writes its own checkpoint data on the same step
- stop requests (e.g. COMMITTOR): GROMACS stops one step after the next step at which it communicates signals,
  writing a checkpoint
- polarizable models with shells: PLUMED updates once per step (with ENERGY, before the shells
  are relaxed: mdrun warns about it)
- runtime MPI injection for PLUMED 2.11 kernels (API version 13 or newer). When a PLUMED kernel
  predates this API, parallel simulations using GROMACS thread-MPI remain rejected.
- restarts (mdrun -cpi, also with -noappend): PLUMED is told the step of the GROMACS checkpoint, and
  removes from its files the lines written at or after it, as GROMACS does with its own files
  (needs PLUMED 2.11 or later; see RESTART in the PLUMED manual)

Patching must be done in the gromacs root directory  _before_ the cmake command is invoked.
The usual top-level Plumed.h is used; GROMACS's bundled header is left unchanged.

The patch supports GROMACS thread-MPI and native MPI builds. With a PLUMED 2.11 kernel,
thread-MPI is injected from the GROMACS host. Older kernels still reject parallel thread-MPI runs.
For native MPI, configure with -DGMX_THREAD_MPI=OFF -DGMX_MPI=ON.

For a serial PLUMED build using runtime linking, patch GROMACS before configuring it:

plumed patch -p --runtime -e gromacs-2026.0

Use the serial kernel at runtime. For example, with thread-MPI:

export PLUMED_KERNEL=/path/to/libplumedKernel.so
gmx mdrun -ntmpi 4 -ntomp 2 -plumed plumed.dat

For native MPI, GROMACS owns MPI initialization and passes its MPI implementation to PLUMED:

mpiexec -n 4 gmx_mpi mdrun -ntomp 2 -plumed plumed.dat

Replica exchange requires native MPI (not thread-MPI) and the matching PLUMED 2.11
kernel. Use -multidir and -replex for bias or native lambda exchange. Native lambda
exchange uses the normal free-energy settings, without -hrex. Arbitrary exchange
patterns require calc-lambda-neighbors=-1 so that every selected energy is available.
For -hrex, also use -notunepme and homogeneous PME settings; the guarded prototype
  requires CPU update and currently supports only the PLUMED force provider.

For alchemical metadynamics use free-energy=expanded, normally integrator=md-vv,
and a PLUMED input with EXTRACV NAME=lambda. The modular simulator supports
checkpoints; GROMACS still disables them for legacy expanded ensembles.

The injected implementation takes precedence over ordinary PLUMED provider discovery. The
embedded PLUMED thread-MPI runtime is not used by this integration.

To enable PLUMED in a gromacs simulation one should use
mdrun with an extra -plumed flag. The flag can be used to
specify the name of the PLUMED input file, e.g.:

gmx mdrun -plumed plumed.dat

For more information on gromacs you should visit http://www.gromacs.org

EOF
}


plumed_ignore_mpi=yes

PLUMED_PATCH_EXTRA_FILES="src/gromacs/mdrun/plumedexchange.h"

# The stored baselines are GROMACS 2026.4. Releases 2026.0-2026.3 differ from it
# in plumedforceprovider.cpp by GROMACS !6133, which fixed setMPIComm to pass
# the address of the communicator. Apply that same change to older trees before
# patching, so one set of baselines fits every 2026 release, and keep the true
# original as the .preplumed backup so that reverting restores it exactly.
plumed_2026_forceprovider=src/gromacs/applied_forces/plumed/plumedforceprovider.cpp
plumed_2026_oldcall='plumed_->cmd("setMPIComm", options.mpiComm_->comm());'
plumed_2026_runner=src/gromacs/mdrun/runner.cpp

plumed_before_patch(){
  plumed_patch_info
  local f=$plumed_2026_forceprovider
  if grep -qF "$plumed_2026_oldcall" "$f" ; then
    cp "$f" "$f.plumed-original"
    awk -v old="$plumed_2026_oldcall" '{
      if (index($0, old)) {
        ind = substr($0, 1, match($0, /[^ ]/) - 1)
        print ind "/* PLUMED reads this argument as an MPI_Comm*, so it must be handed the"
        print ind "   address of a communicator rather than the communicator itself. */"
        print ind "MPI_Comm plumedComm = options.mpiComm_->comm();"
        print ind "plumed_->cmd(\"setMPIComm\", &plumedComm);"
      } else print
    }' "$f.plumed-original" > "$f"
  fi
  # Older releases also lack the Torch exception to GPU cleanup. Normalize the
  # cleanup hunk for patching, then remove the unavailable Torch condition again
  # afterward. Keep the real original for exact reversion, as above.
  f=$plumed_2026_runner
  if grep -q '^        if (GMX_GPU)$' "$f" ; then
    cp "$f" "$f.plumed-original"
    awk '{
      if ($0 == "        if (GMX_GPU)") {
        print "        // Only release GPU when not using torch, as torch keeps some device handles that"
        print "        // only get cleaned up on process exit"
        print "        if (GMX_GPU && !GMX_TORCH)"
      } else print
    }' "$f.plumed-original" > "$f"
  fi
}

plumed_after_patch(){
  local f=$plumed_2026_forceprovider
  if [ -f "$f.plumed-original" ] ; then
    mv "$f.plumed-original" "$f.preplumed"
  fi
  f=$plumed_2026_runner
  if [ -f "$f.plumed-original" ] ; then
    awk '{
      if ($0 == "        // Only release GPU when not using torch, as torch keeps some device handles that" ||
          $0 == "        // only get cleaned up on process exit") next
      sub(/ && !GMX_TORCH/, "")
      print
    }' "$f" > "$f.plumed-patched"
    mv "$f.plumed-patched" "$f"
    mv "$f.plumed-original" "$f.preplumed"
  fi
}
